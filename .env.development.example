# Copy to .env.development.local. These defaults connect to Compose's PostgreSQL.
# For an existing server, replace the PG connection values with its details.
PGHOST=postgres
PGPORT=5432
PGUSER=shipping_ai

# Rails connection password.
PGPASSWORD=replace-with-a-local-password

# Compose PostgreSQL initialization only; match PGPASSWORD on first startup.
# Unused when Rails connects to an existing PostgreSQL server.
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional for servers that require TLS. Choose the mode required by your server.
# PGSSLMODE=require
